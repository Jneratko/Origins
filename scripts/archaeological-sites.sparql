PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX psv: <http://www.wikidata.org/prop/statement/value/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX schema: <http://schema.org/>
PREFIX bd: <http://www.bigdata.com/rdf#>

SELECT DISTINCT ?site ?siteLabel ?siteDescription ?country ?countryLabel ?coordinates
  ?inceptionDate ?datePrecision ?calendarModel ?article
WHERE {
  ?site wdt:P31/wdt:P279* wd:Q839954;
        wdt:P625 ?coordinates;
        p:P571 ?dateStatement.
  FILTER(isLiteral(?coordinates))
  OPTIONAL { ?site schema:description ?siteDescription. FILTER(LANG(?siteDescription) = "en") }
  OPTIONAL { ?site wdt:P17 ?country. }
  ?dateStatement a wikibase:BestRank;
                 psv:P571 ?dateValue.
  ?dateValue wikibase:timeValue ?inceptionDate;
             wikibase:timePrecision ?datePrecision;
             wikibase:timeCalendarModel ?calendarModel.
 FILTER(
  YEAR(?inceptionDate) >= -1000000 &&
  YEAR(?inceptionDate) <= 1500)
  ?article schema:about ?site;
           schema:isPartOf <https://en.wikipedia.org/>.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?site ?inceptionDate ?coordinates ?article ?country
LIMIT 1000
